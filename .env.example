# ── CodeSystems config ───────────────────────────────────
# Path inside the container to the codesystems.yml file.
# Mount the file via docker-compose volumes (see docker-compose.yml).
CODESYSTEMS_CONFIG=/app/codesystems.yml

# ── Docker Compose profiles ─────────────────────────────
# `messaging` starts RabbitMQ (needed for RELAY_TARGET=rabbitmq).
# Remove it for database-only (RELAY_ENABLED=false) or RELAY_TARGET=fhir.
# Add `forwarder` to also run the RabbitMQ → FHIR forwarder.
COMPOSE_PROFILES=messaging

# ── Poll schedule (cron expression) ─────────────────────
# Default: every 4 hours. Daily at 03:00: POLL_CRON="0 3 * * *"
POLL_CRON=0 */4 * * *

# ── Hashing strategy ────────────────────────────────────
# Set to "true" if the FHIR server returns non-deterministic JSON
# (field order or whitespace changes between identical responses)
CANONICAL_HASH=false

# ── PostgreSQL ───────────────────────────────────────────
POSTGRES_USER=poller
POSTGRES_PASSWORD=change-me
POSTGRES_DB=codesystem_poller
DATABASE_URL=postgresql://poller:change-me@db:5432/codesystem_poller

# ── RabbitMQ ─────────────────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=change-me
RABBITMQ_URL=amqp://guest:change-me@rabbitmq:5672/
RABBITMQ_EXCHANGE=codesystem.changes

# ── Downstream FHIR endpoint ─────────────────────────────
# Used by RELAY_TARGET=fhir (direct, no RabbitMQ) and by the forwarder.
# URL of the downstream FHIR server that receives $process-message Bundles
# Write $ as $$ — docker compose interpolates variables in this file.
FHIR_TARGET_URL=https://your-downstream-fhir-server.example/fhir/$$process-message
# Auth — use one method, leave the others blank
# Bearer token:
FHIR_AUTH_TOKEN=
# Basic auth:
FHIR_AUTH_USER=
FHIR_AUTH_PASSWORD=

# ── Outbox relay ─────────────────────────────────────────
# false = database-only mode: changes are stored (including the outbox, as
# change history) but nothing is published. Enabling it later delivers the
# whole backlog.
RELAY_ENABLED=true
OUTBOX_POLL_INTERVAL=5
# rabbitmq = publish to RABBITMQ_EXCHANGE (needs the `messaging` profile)
# fhir     = POST directly to FHIR_TARGET_URL ($process-message), no RabbitMQ
RELAY_TARGET=rabbitmq
# Max changes per Bundle
RELAY_BATCH_SIZE=500
# Retry backoff for failed deliveries: base doubles per attempt, capped at max.
# Transient failures are retried forever; nothing is dropped.
RELAY_RETRY_BASE=5
RELAY_RETRY_MAX=900
# When the target rejects a Bundle (HTTP 400/409/410/413/415/422 or a
# fatal-error response message):
#   dead_letter = park it as dead, keep delivering later changes
#   block       = park it and hold back later changes of that CodeSystem
# Inspect/requeue with: python -m src.outbox_admin status|dead|requeue|discard
RELAY_ON_REJECT=dead_letter

# ── General ──────────────────────────────────────────────
LOG_LEVEL=INFO
HTTP_TIMEOUT=30
# Retries for fetching a CodeSystem (network errors, 5xx, 429)
HTTP_RETRIES=3
# Skip a CodeSystem whose `count` differs from the concepts returned
ALLOW_COUNT_MISMATCH=false
